# Frontend (TanStack Start / Vite) — copy to .env
# Use the same host style as the API (localhost vs 127.0.0.1) for Sanctum cookies.
VITE_API_URL=http://localhost:8000
VITE_REAL_CHAT=true

# Exact origins allowed to embed /widget in addition to each brand allowlist (local widget-demo).
# Must align with api WIDGET_PREVIEW_ORIGINS. Comma-separated scheme://host[:port].
VITE_WIDGET_PREVIEW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Laravel Reverb (Echo) — must match api/.env
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http
