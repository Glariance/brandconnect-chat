APP_NAME=BrandConnect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Frontend (TanStack Start / Vite). Lovable's vite dev server uses 8080; 3000 and 5173 are also allowed below.
# Use the same host style (localhost OR 127.0.0.1) for the SPA and API, or cookies break.
FRONTEND_URL=http://localhost:8080
# Comma-separated browser origins allowed by CORS (credentialed requests).
# These are BrandConnect SPA origins (dashboard + /widget iframe host), NOT customer parent sites.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# Hosts that receive stateful (cookie) Sanctum auth. Only the dashboard /api/v1 routes are stateful.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,localhost:5173,127.0.0.1:5173,localhost:8080,127.0.0.1:8080,localhost:8000,127.0.0.1:8000

# Widget embedding (CSP frame-ancestors on the TanStack /widget HTML response).
# Exact preview origins (scheme://host[:port]) always merged into each brand's frame-ancestors.
WIDGET_PREVIEW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# When true, brand allowed_origins may include http://localhost / 127.0.0.1 / ::1.
WIDGET_ALLOW_LOCALHOST_ORIGINS=false

# Anonymous widget visitor bearer-token lifetime (minutes). Default 30 days.
VISITOR_SESSION_MINUTES=43200

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laragon MySQL 8.4. Create the database first (see docs/LOCAL_SETUP.md).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=brandconnect_chat
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Redis is NOT required locally: queue and cache use the database driver.
# Run `php artisan queue:work` so broadcasts (ShouldBroadcast) are delivered.
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Self-hosted Laravel Reverb. Generate values with `php artisan reverb:install` or any random strings.
# The frontend's VITE_REVERB_APP_KEY / HOST / PORT / SCHEME must match.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081
# Browser Echo connects from the BrandConnect frontend origin (iframe/dashboard), not customer sites.
REVERB_ALLOWED_ORIGINS="${CORS_ALLOWED_ORIGINS}"

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
